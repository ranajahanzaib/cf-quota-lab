{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "quotalab-budget-violations",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  "vars": {
    "QUOTALAB_LOCAL": "false",
    "QUOTALAB_TOKEN": "",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quotalab-fixture",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "00000000000000000000000000000001",
    },
  ],
}
